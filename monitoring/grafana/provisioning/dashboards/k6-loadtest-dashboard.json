  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "초당 요청 수",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "Request Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "cps", "color": { "mode": "palette-classic" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "9.5.1"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error Rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "에러율 %",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(k6_http_req_failed_total[$__rate_interval])) / sum(rate(k6_http_reqs_total[$__rate_interval])) * 100",
          "legendFormat": "Error Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "9.5.1"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active VUs",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "활성 VU",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(k6_vus)",
          "legendFormat": "Active VUs",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "pluginVersion": "9.5.1"
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Upload Count",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "업로드 요청 수 (AOP)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(note_image_upload_total_seconds_count[$__rate_interval]))",
          "legendFormat": "Upload Count",
          "range": true,
          "refId": "A"
