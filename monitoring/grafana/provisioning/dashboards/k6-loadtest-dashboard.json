        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "editorMode": "code", "expr": "histogram_quantile(0.95, sum(rate(k6_upload_duration_bucket[$__rate_interval])) by (le, size))", "legendFormat": "{{size}}", "range": true, "refId": "A" }
