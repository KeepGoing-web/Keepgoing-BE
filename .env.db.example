POSTGRES_DB=keepgoing
POSTGRES_USER=keepgoing
POSTGRES_PASSWORD=CHANGE_ME

# postgres_exporter 전용 계정 (모니터링). 운영 서버 DB에서 아래 SQL 실행 필요:
#   CREATE USER postgres_exporter WITH PASSWORD 'CHANGE_ME';
#   GRANT CONNECT ON DATABASE keepgoing TO postgres_exporter;
#   GRANT pg_monitor TO postgres_exporter;
POSTGRES_EXPORTER_PASSWORD=CHANGE_ME
