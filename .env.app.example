SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xms256m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# 운영 기본값은 validate 권장. 빈 PostgreSQL에 최초 부팅해야 할 때만 일시적으로 update 사용 후 되돌리세요.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
OAUTH_GOOGLE_CLIENT_ID=CHANGE_ME
OAUTH_GOOGLE_CLIENT_SECRET=CHANGE_ME
OAUTH_REDIRECT_URI=https://app.example.com/oauth/callback
CORS_ALLOWED_ORIGINS=https://app.example.com

# TLS 미적용 상태의 운영 테스트 기본값. HTTPS 적용 후 secure=true / same-site=None 으로 전환하세요.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# API-only 배포 기준: worker/Redis Streams 파이프라인은 아직 운영하지 않으므로 API의 result listener를 끕니다.
# 이미지 업로드 기능을 운영하려면 Redis/worker 배포와 함께 true로 전환하세요.
IMAGE_PROCESSING_STREAMS_ENABLED=false

# object storage (S3 호환: AWS S3, OCI Object Storage, MinIO 등)
STORAGE_ENDPOINT=CHANGE_ME_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY=CHANGE_ME_STORAGE_ACCESS_KEY
STORAGE_SECRET_KEY=CHANGE_ME_STORAGE_SECRET_KEY
STORAGE_REGION=CHANGE_ME_STORAGE_REGION
STORAGE_BUCKET_QUARANTINE=CHANGE_ME_QUARANTINE_BUCKET
STORAGE_BUCKET_SECURE=CHANGE_ME_SECURE_BUCKET

# ai
ZHIPUAI_API_KEY=CHANGE_ME
# 기본값: https://api.z.ai/api/coding/paas
# ZHIPUAI_BASE_URL=https://api.z.ai/api/coding/paas
