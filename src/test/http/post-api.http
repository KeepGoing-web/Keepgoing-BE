@host = http://localhost:8080

### 0-0. 회원가입
POST {{host}}/api/auth/signup
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "Password123!",
  "name": "test"
}

### 0. 로그인 -> accessToken 저장
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "test@test.com",
  "password": "Password123!"
}

> {%
    const body = response.body;
    const token = body?.data?.accessToken ?? body?.data?.token ?? body?.accessToken;
    if (!token) {
        throw new Error("login 응답에서 accessToken을 찾지 못했습니다. (body.data.accessToken / body.data.token / body.accessToken)");
    }
    client.global.set("accessToken", token);
%}



### 1. POST /api/posts – 새 글 작성
POST {{host}}/api/posts
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "첫 번째 글 제목",
  "content": "첫 번째 글 내용입니다.",
  "visibility": "PRIVATE",
  "aiCollectable": true
}

> {%
    const body = response.body;
    const postId = body?.data?.postId ?? body?.data?.id;
    if (!postId) {
        throw new Error("post 생성 응답에서 postId를 찾지 못했습니다. (body.data.postId 또는 body.data.id)");
    }
    client.global.set("postId", postId);
%}

### 2) GET /api/posts/{id} – 방금 작성한 글 조회
GET {{host}}/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}


### 3) GET /api/posts/me – 내 글 목록 조회
GET {{host}}/api/posts/me
Authorization: Bearer {{accessToken}}


### 3-1) GET /api/posts/me – 내 글 목록 1페이지(size=5) 조회
GET {{host}}/api/posts/me?page=0&size=5
Authorization: Bearer {{accessToken}}


### 3-2) GET /api/posts/me – 내 글 목록 2페이지(size=5) 조회
GET {{host}}/api/posts/me?page=1&size=5
Authorization: Bearer {{accessToken}}


### 4) PUT /api/posts/{id} – 글 수정
PUT {{host}}/api/posts/{{postId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "title": "수정된 글 제목",
  "content": "수정된 글 내용입니다.",
  "visibility": "PUBLIC",
  "aiCollectable": false
}


### 5) DELETE /api/posts/{id} – 글 삭제
DELETE {{host}}/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}


### 6) 삭제 후 GET /api/posts/{id} – 예외 응답 확인
GET {{host}}/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}


#### 7) PUT /api/posts/{id} – 작성자 아닌 경우 POST_ACCESS_DENIED 확인
