# compose project
COMPOSE_PROJECT_NAME=keepgoing
TZ=Asia/Seoul

# app image
APP_IMAGE=ghcr.io/keepgoing-web/keepgoing-be-api
APP_IMAGE_TAG=latest
# 최초 TLS 인증서 발급과 TLS compose 수동 전환이 끝난 뒤 true로 변경하세요.
DEPLOY_TLS_ENABLED=false

# storage
POSTGRES_DATA_DIR=./var/postgres-data
BACKUP_DIR=./backups

# nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=app.example.com
NGINX_CERT_NAME=app.example.com
TLS_CERTS_DIR=./var/certs
TLS_ACME_CHALLENGE_DIR=./var/www/certbot
