# compose project
COMPOSE_PROJECT_NAME=keepgoing
TZ=Asia/Seoul
SPRING_PROFILES_ACTIVE=prod

# docker compose env_file input files
APP_ENV_FILE=.env.app
DB_ENV_FILE=.env.db

# storage
POSTGRES_DATA_DIR=./var/postgres-data
BACKUP_DIR=./backups

# nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_SERVER_NAME=app.example.com
NGINX_CERT_NAME=app.example.com
TLS_CERTS_DIR=./var/certs
TLS_ACME_CHALLENGE_DIR=./var/www/certbot
